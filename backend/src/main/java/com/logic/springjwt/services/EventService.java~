@Service
public class EventService {

    private final EventRepository eventRepository;
    private final MediaRepository mediaRepository;

    @Value("${app.upload.dir}")
    private String uploadDir;

    @Autowired
    public EventService(EventRepository eventRepository, MediaRepository mediaRepository) {
        this.eventRepository = eventRepository;
        this.mediaRepository = mediaRepository;
    }

    // ================= SAVE EVENT =================
    public Event saveEvent(Event event) {
        event.setAddedEventAt(LocalDateTime.now());
        event.setLatestUpdateAt(LocalDateTime.now());
        return eventRepository.save(event);
    }

    // ================= UPLOAD MEDIA =================
    public Media uploadEventMedia(Long eventId, MultipartFile file) {

        if (!isValidEventContent(file)) {
            throw new RuntimeException("Invalid file type. Only images and videos allowed.");
        }

        Event event = getEventByID(eventId);

        String uniqueName = setContentNameAsUnique(file);

        // Folder: /uploads/Events/{eventName}
        Path eventFolder = Paths.get(uploadDir, "Events", event.getEventName());

        try {
            Files.createDirectories(eventFolder);

            Path filePath = eventFolder.resolve(uniqueName);
            Files.copy(file.getInputStream(), filePath);

            Media media = new Media();
            media.setContentName(uniqueName);
            media.setContentPath(filePath.toString());
            media.setEvent(event);
//            media.setUploadedAt(LocalDateTime.now());

            return mediaRepository.save(media);

        } catch (IOException e) {
            throw new RuntimeException("Media upload failed", e);
        }
    }

    // ================= VALIDATION =================
    public boolean isValidEventContent(MultipartFile file) {
        String type = file.getContentType();
        return type != null &&
                (type.startsWith("image/") || type.startsWith("video/"));
    }

    public String setContentNameAsUnique(MultipartFile file) {
        String original = StringUtils.cleanPath(file.getOriginalFilename());
        String ext = original.substring(original.lastIndexOf("."));
        return UUID.randomUUID() + ext;
    }

    // ================= FETCH =================
    public Event getEventByID(Long eventId) {
        return eventRepository.findById(eventId)
                .orElseThrow(() -> new RuntimeException("Event not found"));
    }

    public List<Event> getAllEvent() {
        return eventRepository.findAllByOrderByAddedEventAtDesc();
    }

    public List<Media> getContentByEventId(Long eventId) {
        return getEventByID(eventId).getMedia();
    }

    // ================= DELETE EVENT + FILES =================
    public void deleteEvent(Long eventId) {
        Event event = getEventByID(eventId);

        Path eventPath = Paths.get(uploadDir, "Events", event.getEventName());

        try {
            deleteFolder(eventPath);
        } catch (IOException e) {
            throw new RuntimeException("Failed to delete event files", e);
        }

        eventRepository.delete(event);
    }

    private void deleteFolder(Path path) throws IOException {
        if (Files.exists(path)) {
            Files.walk(path)
                    .sorted((a, b) -> b.compareTo(a))
                    .forEach(p -> {
                        try {
                            Files.delete(p);
                        } catch (IOException e) {
                            throw new RuntimeException(e);
                        }
                    });
        }
    }

    // ================= STATUS UPDATE =================
    public Event updateEventStatus(Long eventId, UpdateStatusDTO dto) {
        Event event = getEventByID(eventId);
        event.setStatus(dto.getStatus());
        event.setLatestUpdateAt(LocalDateTime.now());
        return eventRepository.save(event);
    }
}
